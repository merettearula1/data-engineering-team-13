# ------------------------------------------------------------------
# Environment variables template for the Tartu Transit pipeline.
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your own values in .env (e.g. a real password).
#   3. Make sure .env is listed in .gitignore, so it is NEVER
#      committed to GitHub. Only .env.example is committed.
#
# Check with `git status`: .env must not appear in the list.
# ------------------------------------------------------------------

POSTGRES_USER=de_user
POSTGRES_PASSWORD=[placeholder]
WAREHOUSE_DB=tartu_transit
# Shared prefix for the documented Ridango public REST endpoints, for example
# /v1/stops and /v1/routes. It deliberately excludes the endpoint path.
BUS_API_BASE_URL=https://wmb-public-api-tartu.eu-prod.ridango.cloud
WEATHER_INTERVAL_SECONDS=600
REFERENCE_INTERVAL_SECONDS=86400
TIMETABLE_INTERVAL_SECONDS=86400
DEPARTURES_INTERVAL_SECONDS=300
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=3
HTTP_BACKOFF_SECONDS=2
MAX_CONCURRENT_REQUESTS=8
BUS_REQUEST_CONCURRENCY=8
WEBSOCKET_MAX_BACKOFF_SECONDS=60
DEPENDENCY_RETRY_SECONDS=60
AZURE_STORAGE_ACCOUNT_URL=https://tarturawdata.blob.core.windows.net
AZURE_STORAGE_CONTAINER=raw-data